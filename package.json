{
  "name": "flatsql",
  "version": "0.1.0",
  "private": true,
  "description": "Flat-SQL: SQL database engine in Rust compiled to WebAssembly (Local-First, offline sync)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wasm-pack build crates/flatsql-wasm --release --target web --out-dir ../../pkg --out-name flatsql",
    "build:dev": "wasm-pack build crates/flatsql-wasm --dev --target web --out-dir ../../pkg --out-name flatsql",
    "test": "node --test \"test/**/*.test.js\"",
    "test:rust": "cargo test --workspace",
    "start": "node server/server.js",
    "start:persistent": "node server/server.js --data server/data",
    "bench": "node bench/run.js --targets node",
    "bench:full": "cargo build --release -p flatsql-cli && node bench/run.js --targets node,native,browser",
    "bench:browser": "node bench/run.js --targets browser",
    "bench:serve": "node bench/browser/serve.js"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@electric-sql/pglite": "0.5.11",
    "@journeyapps/wa-sqlite": "2.0.8",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "alasql": "4.21.0",
    "dexie": "4.4.7",
    "esbuild": "0.28.2",
    "events": "3.3.0",
    "playwright-core": "1.64.1",
    "pouchdb-browser": "9.0.0",
    "rxdb": "17.6.0",
    "sql.js": "1.14.2"
  }
}
